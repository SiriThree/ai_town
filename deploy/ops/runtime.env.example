# /etc/ai-town/runtime.env: root:root 0600, parsed by systemd (not shell source).
DATABASE_URL=postgresql://town_app:URL_ENCODED_PASSWORD@127.0.0.1:5432/ai_town_mvp
WORLD_ID=public-demo
COOKIE_SIGNING_SECRET=
AI_ENABLED=false
AI_API_KEY=
# Set the regional Qwen OpenAI-compatible endpoint in protected config.
AI_BASE_URL=
AI_MODEL=qwen-plus
AI_TIMEOUT_MS=8000
AI_CALLS_PER_DAY=60
CHAT_REQUESTS_PER_MINUTE=30
NEXT_TELEMETRY_DISABLED=1
