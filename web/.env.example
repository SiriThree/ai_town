# Only this project's new local development database; these are public local-only credentials.
DATABASE_URL=postgresql://town_local:town_local_only@127.0.0.1:55487/ai_town_mvp
WORLD_ID=morning-town
# For .env.test.local use port 55488, database ai_town_mvp_test and WORLD_ID=browser-test.

# Server-only. Leave empty for usable local fallback. Enable only after authorizing calls.
AI_ENABLED=false
AI_API_KEY=
# API prefix, including /v1 if required; the app appends /chat/completions.
AI_BASE_URL=
AI_MODEL=
AI_TIMEOUT_MS=8000

# Shared-world limits; enforced in PostgreSQL (including failed model attempts).
CHAT_REQUESTS_PER_MINUTE=30
AI_CALLS_PER_DAY=60
# Set true for public deployments: HTTP initialization is disabled.
PUBLIC_DEMO=false

# Production: at least 32 random bytes; set only in protected runtime environment.
COOKIE_SIGNING_SECRET=
