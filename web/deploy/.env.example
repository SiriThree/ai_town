# Copy to .env.production; never include that file in source delivery.
DEMO_DOMAIN=town.example.com
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
# URL-encode the same password here. db is the private compose service.
DATABASE_URL=postgresql://town_prod:REPLACE_WITH_RANDOM_PASSWORD@db:5432/ai_town_mvp
WORLD_ID=public-demo
PUBLIC_DEMO=true
AI_ENABLED=false
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_TIMEOUT_MS=8000
CHAT_REQUESTS_PER_MINUTE=30
AI_CALLS_PER_DAY=60

# Required for anonymous private chat in PUBLIC_DEMO mode.
COOKIE_SIGNING_SECRET=
