# Site block only: merge into existing Caddy config after reviewing occupied ports.
# Replace this domain before validation. Do not overwrite other sites or global options.
town.example.com {
    request_body {
        max_size 8KB
    }
    reverse_proxy 127.0.0.1:3100 {
        transport http {
            dial_timeout 3s
            response_header_timeout 30s
        }
    }
    header Strict-Transport-Security "max-age=86400"
}
